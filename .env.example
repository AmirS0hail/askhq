# LLM Provider ("ollama" or "huggingface")
LLM_PROVIDER=ollama

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=60
TEMPERATURE=0.1

# Hugging Face (used when LLM_PROVIDER=huggingface)
HF_API_KEY=
HF_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.2
HF_TIMEOUT=120

# Vector DB
CHROMA_DIR=./data/chroma
COLLECTION_NAME=alfabolt_policies
TOP_K=5
MIN_SIMILARITY=0.4

# Paths
KNOWLEDGE_DIR=./knowledge

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
DEBUG=false

# Security
REINDEX_TOKEN=changeme-local-dev-token
